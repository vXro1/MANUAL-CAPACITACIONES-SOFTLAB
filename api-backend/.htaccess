# Este archivo va en public_html/ (raíz del sitio)
Options -MultiViews
RewriteEngine On

# 1. Dejar pasar peticiones a la carpeta /api/ directamente (PHP)
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^ - [L]

# 2. Dejar pasar archivos y carpetas que existen (assets del build de React)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Todo lo demás → index.html (React Router)
RewriteRule ^ /index.html [L]
