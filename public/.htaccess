# ─── MIME types para módulos JavaScript (ES modules de Vite) ─────────────────
# Sin esto Apache sirve los .js como text/plain y el navegador los rechaza.
AddType application/javascript .js .mjs
AddType text/css               .css
AddType image/svg+xml          .svg
AddType application/json       .json
AddType font/woff2             .woff2
AddType font/woff              .woff

# ─── Compresión (mejora rendimiento) ─────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript text/css text/html application/json
</IfModule>

# ─── Cache de assets estáticos ────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType image/svg+xml        "access plus 1 month"
</IfModule>

# ─── React Router (SPA fallback) ─────────────────────────────────────────────
Options -MultiViews
RewriteEngine On

# 1. Dejar pasar peticiones a /api/ (PHP backend)
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^ - [L]

# 2. Dejar pasar archivos y carpetas que existen en disco (assets del build)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Todo lo demás → index.html (React Router maneja las rutas)
RewriteRule ^ /index.html [L]
